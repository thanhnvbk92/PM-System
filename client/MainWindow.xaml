<Window x:Class="PMSystem.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PM System - Log Monitor Client" Height="600" Width="800">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="Log Monitoring &amp; Collection System" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Collect and send logs to the server in real-time" FontSize="12" Foreground="#BDC3C7" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- File Selection &amp; Controls -->
        <Border Grid.Row="1" Background="White" BorderBrush="#ECF0F1" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Log File Path:" VerticalAlignment="Center" Width="100"/>
                    <TextBox Text="{Binding LogFilePath, Mode=TwoWay}" Height="32" Padding="10" Margin="10,0,10,0" Background="#ECF0F1" Foreground="Black" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Start Monitoring" Command="{Binding StartMonitoringCommand}" Height="36" Padding="15,0" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="Stop Monitoring" Command="{Binding StopMonitoringCommand}" Height="36" Padding="15,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="Send Logs" Command="{Binding SendLogsAsyncCommand}" Height="36" Padding="15,0" Background="#3498DB" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="Clear" Command="{Binding ClearLogsCommand}" Height="36" Padding="15,0" Background="#95A5A6" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Server Status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ServerStatus}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,20,0"/>
                    <TextBlock Text="Monitoring:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding IsMonitoring}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Log List &amp; Details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Log List -->
            <Border Grid.Column="0" Margin="15">
                <StackPanel>
                    <TextBlock Text="{Binding LogCount, StringFormat='Logs Collected: {0}'}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding LogEntries}" AutoGenerateColumns="False" BorderBrush="#BDC3C7" BorderThickness="1" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Status Panel -->
            <Border Grid.Column="1" Margin="0,15,15,15" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Status Information" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20" Foreground="#34495E"/>

                    <TextBlock Text="Monitoring Status" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding IsMonitoring, StringFormat='Active: {0}'}" FontSize="11" Margin="0,0,0,15"/>

                    <TextBlock Text="Log Count" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding LogCount}" FontSize="11" Margin="0,0,0,15"/>

                    <TextBlock Text="Server Connection" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ServerStatus}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StatusBar Grid.Row="3" Background="#ECF0F1" Padding="10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#34495E"/>
        </StatusBar>
    </Grid>
</Window>
